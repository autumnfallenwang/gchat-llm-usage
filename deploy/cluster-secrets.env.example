# Template for cluster-secrets.env (gitignored). Copy to ./cluster-secrets.env at the repo root,
# fill in the real value, then run:
#   bash scripts/create-cluster-secret.sh
#
# The key must match the secretKeyRef in deploy/chart/templates/cronjob.yaml. The chart never sees
# the value: it's injected via the gchat-llm-usage-secrets Secret the script creates (ADR 0004).

# The space's incoming webhook (Space → Apps & integrations → Webhooks). Anyone with it can post there.
GCHAT_WEBHOOK_URL=https://chat.googleapis.com/v1/spaces/SPACE_ID/messages?key=KEY&token=TOKEN
